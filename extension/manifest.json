{
  "manifest_version": 3,
  "name": "__MSG_app_name__",
  "short_name": "__MSG_app_short_name__",
  "version": "1.0.4",
  "description": "__MSG_app_desc__",
  "default_locale": "en",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Crunchyroll için Çift Altyazı",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.crunchyroll.com/*",
    "https://translate.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.crunchyroll.com/*"],
      "js": ["src/page/hook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://*.crunchyroll.com/*"],
      "js": [
        "src/shared/i18n.js",
        "src/shared/languages.js",
        "src/shared/settings.js",
        "src/content/subtitles.js",
        "src/shared/words.js",
        "src/content/overlay.js",
        "src/content/content.js"
      ],
      "css": ["src/content/page.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["_locales/*/messages.json"],
      "matches": ["https://*.crunchyroll.com/*"]
    }
  ],
  "commands": {
    "toggle-overlay": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "__MSG_cmd_toggle_overlay__"
    },
    "toggle-translation": {
      "suggested_key": { "default": "Alt+Shift+Y" },
      "description": "__MSG_cmd_toggle_translation__"
    }
  }
}
